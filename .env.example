# ── Ports ─────────────────────────────────────────────────────────────────────
WEBUI_PORT=3000
DOCLING_PORT=5001
# VLLM_PORT is only used if you uncomment vllm's `ports:` mapping in
# docker-compose.yml (off by default — see the vLLM section below).
VLLM_PORT=8000
EMBEDDER_PORT=7997

# ── Open WebUI ────────────────────────────────────────────────────────────────
WEBUI_AUTH=true
# IMPORTANT: change this before first run
WEBUI_SECRET_KEY=replace-with-a-strong-random-secret
# Shared by open-webui and guardrails — both use vLLM's OpenAI-compatible API.
OPENAI_API_KEY=EMPTY

# ── HuggingFace model cache ───────────────────────────────────────────────────
# Bind-mounted into vLLM, embedder, and reranker containers.
# Models are downloaded once and reused across restarts and `docker compose down`.
# Set an absolute path to share the cache with other projects or host tools.
HF_CACHE_DIR=./hf_cache

# ── vLLM (inference) ──────────────────────────────────────────────────────────
# Official NVIDIA NGC vLLM image — no custom build needed.
# Check for newer tags at: https://catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm
VLLM_NGC_TAG=26.06-py3
# Any HuggingFace model ID. Gated models require HUGGING_FACE_HUB_TOKEN.
# Default: Gemma 4 26B-A4B (MoE, 25.2B total / 3.8B active params), NVIDIA's
# official NVFP4 quant. TP=1 only — this model has no expert-parallelism
# support in vLLM yet, do not raise VLLM_TENSOR_PARALLEL_SIZE for it.
#   nvidia/Gemma-4-26B-A4B-NVFP4                 — 26B-A4B MoE, native FP4
#
# Nemotron-Nano variants (both require ./vllm_plugins/nano_v3_reasoning_parser.py
# AND swapping docker-compose.yml's vllm command flags back to
# --tool-call-parser qwen3_coder / --reasoning-parser-plugin / --reasoning-parser
# nano_v3 — see the note in docker-compose.yml and README.md):
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4  — 30B MoE, native FP4, ~15 GB
#   nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16         — 4B BF16, 262K ctx, ~8 GB
VLLM_MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
VLLM_TENSOR_PARALLEL_SIZE=1     # keep at 1 for Gemma-4-26B-A4B (see above)
VLLM_MAX_MODEL_LEN=32768        # 262144 max; keep lower to save memory
VLLM_MAX_NUM_SEQS=8
# GB10 unified memory note: vLLM sees the full 128 GB shared pool.
# Weights: Gemma-4-26B-A4B-NVFP4 is ~13-17 GB (community-reported quantized
# size for the same base model; NVIDIA's official quant should be similar).
# KV cache size at a given utilization has NOT been re-measured on this
# hardware since switching from Nemotron-3-Nano-30B-A3B-NVFP4 (Gemma-4 uses
# a different sliding-window/global attention mix, so the previous
# measured ~59 GB KV-cache figure does not transfer) — re-check via
# `nvidia-smi` after deployment and adjust this value accordingly.
# Raise toward 0.70 for longer contexts; lower to 0.35 if adding reranker.
VLLM_GPU_MEMORY_UTILIZATION=0.55
# KV-cache precision — fp8 saves memory; auto falls back to fp16
VLLM_KV_CACHE_DTYPE=fp8
# FP4 MoE kernel tuning — required for NVFP4 MoE models (Gemma-4-26B-A4B,
# Nemotron-30B-A3B); harmless for dense models
VLLM_USE_FLASHINFER_MOE_FP4=1
VLLM_FLASHINFER_MOE_BACKEND=throughput
# Required for gated models (Llama, Mistral, …)
HUGGING_FACE_HUB_TOKEN=

# ── Guardrails (optional — activate with --profile guardrails) ────────────────
# NVIDIA NeMo Guardrails, mediating between Open WebUI and vLLM. Off by
# default (vLLM's port isn't published to the host either way, since traffic
# to it always goes over the internal docker network regardless of this
# profile — see docker-compose.yml). To enable, see README.md "Guardrails".
#
# Switch Open WebUI's inference target here once guardrails is running:
#   OPENAI_API_BASE_URL=http://guardrails:8001/v1
OPENAI_API_BASE_URL=http://vllm:8000/v1
GUARDRAILS_PORT=8001
# debug enables verbose nemoguardrails server logging
GUARDRAILS_LOG_LEVEL=info
# Free text — used by rails/input.co's topic-restriction check (folded into
# the combined self_check_input LLM call) and the refusal message in
# rails/policies.co. Keep it short and specific to your deployment.
GUARDRAILS_ALLOWED_TOPICS="general knowledge questions and the uploaded knowledge base"
# Output rails that validate the full response (self check output, enforce
# citation) buffer regardless of this flag — see README's Guardrails
# section. Set to false to also disable NeMo Guardrails' own SSE streaming
# path if it misbehaves (known upstream issue, see README).
GUARDRAILS_STREAMING_ENABLED=true

# ── Embedder (Infinity — replaces Ollama for RAG embeddings) ──────────────────
# Any sentence-transformers model on HF Hub.
EMBEDDER_MODEL=BAAI/bge-m3      # multilingual, 1024-dim — good default
EMBEDDER_BATCH_SIZE=32
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_OPENAI_API_KEY=EMPTY
RAG_OPENAI_BATCH_SIZE=32

# ── Reranker (optional — activate with --profile reranker) ────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # multilingual cross-encoder
RERANKER_PORT=7998
RERANKER_BATCH_SIZE=32
ENABLE_RAG_HYBRID_SEARCH=false  # switch to: true
RAG_RERANKING_ENGINE=           # switch to: external
RAG_EXTERNAL_RERANKER_URL=http://reranker:7998/rerank
RAG_EXTERNAL_RERANKER_API_KEY=EMPTY
RAG_TOP_K=5
RAG_TOP_K_RERANKER=3

# ── Docling (GB10 thread tuning) ──────────────────────────────────────────────
# Grace CPU has 72 Arm cores — tune these to your workload
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
DOCLING_WORKERS=2

# ── Vector store (optional — activate with --profile qdrant) ──────────────────
# Default: chroma (built-in). To use Qdrant: set VECTOR_DB=qdrant
VECTOR_DB=chroma
QDRANT_URI=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_GRPC_PORT=6334
QDRANT_TIMEOUT=5
QDRANT_HTTP_PORT=6333

# ── Benchmarking (locustfile.py) ──────────────────────────────────────────────
# Generate an API key in Open WebUI → Settings → Account → API Keys
OPENWEBUI_API_KEY=
# Knowledge base UUID — get via:
#   curl http://localhost:3000/api/v1/knowledge \
#     -H "Authorization: Bearer $OPENWEBUI_API_KEY" | jq '.[].id'
OPENWEBUI_KB_ID=
OPENWEBUI_MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
